        "channel": "C0AQFJDT2HE",
        "thread": false,
        "on": {
          "checkin.complete": true,
          "card.created": false,
          "card.claimed": true,
          "card.completed": true,
          "card.blocked": true,
          "card.failed": true,
          "card.unblocked": false,
