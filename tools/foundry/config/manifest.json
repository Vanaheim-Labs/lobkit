{
  "$schema": "./manifest.schema.json",
  "version": "1.1.0",
  "description": "Foundry workspace manifest \u2014 defines workspaces, channel routing, notifications, and policies",
  "workspaces": {
    "heimdall": {
      "name": "Heimdall",
      "description": "Vanaheim Labs internal knowledge base",
      "owner": "andrew",
      "vault": "~/.openclaw/wiki/heimdall",
      "board": "heimdall",
      "agents": [
        "main",
        "heimdall"
      ],
      "channels": [
        {
          "provider": "slack",
          "account": "default",
