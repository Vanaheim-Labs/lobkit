{
  "$schema": "./manifest.schema.json",
  "version": "2.0.0",
  "description": "Foundry workspace manifest — agent-routed, not channel-routed",

  "workspaces": {
    "heimdall": {
      "name": "Heimdall",
      "description": "Vanaheim Labs internal knowledge base",
      "owner": "andrew",
      "vault": "~/.openclaw/wiki/heimdall",
      "board": "heimdall",
      "agents": ["main", "heimdall"],
      "defaultFor": ["main"],
      "notifications": {
        "channel": "C0AQFJDT2HE",
        "thread": false,
        "on": {
          "checkin.complete": true,
          "card.claimed": true,
          "card.completed": true,
          "card.blocked": true,
          "card.failed": true,
          "page.decision_recorded": true
        }
      },
      "dispatch": {
        "maxConcurrent": 3,
        "failurePolicy": "block-after-2",
        "workerModel": null
      },
      "autoCheckin": true,
      "autoDispatch": false,
      "approvalRequired": [
        "more_than_5_cards",
        "updates_existing_decisions",
        "low_confidence_decision",
        "cross_workspace_reference",
        "sensitive_content"
      ]
    },

    "slate": {
      "name": "Slate",
      "description": "Inkl business knowledge base",
      "owner": "andrew",
      "vault": "~/.openclaw/wiki/slate",
      "board": "slate",
      "agents": ["main", "ed"],
      "defaultFor": ["ed"],
      "notifications": {
        "channel": null,
        "on": {
          "checkin.complete": true,
          "card.completed": true,
          "card.blocked": true,
          "card.failed": true,
          "page.decision_recorded": true
        }
      },
      "autoCheckin": true,
      "autoDispatch": false,
      "approvalRequired": [
        "more_than_5_cards",
        "updates_existing_decisions",
        "cross_workspace_reference"
      ]
    },

    "laurion": {
      "name": "Laurion",
      "description": "Project Laurion — financial advice platform",
      "owner": "andrew",
      "vault": "~/.openclaw/wiki/laurion",
      "board": "laurion",
      "agents": ["main", "themis", "barefoot"],
      "defaultFor": ["themis", "barefoot"],
      "notifications": {
        "channel": null,
        "on": {
          "checkin.complete": true,
          "card.completed": true,
          "card.blocked": true,
          "page.decision_recorded": true
        }
      },
      "autoCheckin": false,
      "autoDispatch": false,
      "approvalRequired": [
        "more_than_5_cards",
        "updates_existing_decisions",
        "cross_workspace_reference",
        "sensitive_content"
      ]
    }
  }
}
